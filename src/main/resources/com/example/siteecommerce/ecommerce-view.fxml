<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.siteecommerce.EcommerceController">
   <top>
      <VBox>
         <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50;">
            <padding>
               <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
            </padding>
            <children>
               <Label text="🛍️ E-COMMERCE STORE" textFill="white">
                  <font>
                     <Font name="Arial Bold" size="20.0"/>
                  </font>
               </Label>
               <Region HBox.hgrow="ALWAYS"/>
               <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <children>
                     <Label text="Rechercher:" textFill="white"/>
                     <TextField fx:id="searchField" promptText="Nom du produit..." prefWidth="200.0">
                        <HBox.margin>
                           <Insets right="10.0"/>
                        </HBox.margin>
                     </TextField>
                     <ComboBox fx:id="categoryComboBox" promptText="Catégorie" prefWidth="120.0"/>
                     <Button fx:id="searchButton" text="🔍 Rechercher" onAction="#onSearchClicked" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                  </children>
               </HBox>
               <Region HBox.hgrow="ALWAYS"/>
               <HBox alignment="CENTER_RIGHT" spacing="15.0">
                  <children>
                     <Label fx:id="cartLabel" text="Panier (0)" textFill="white">
                        <font>
                           <Font name="Arial" size="14.0"/>
                        </font>
                     </Label>
                     <Button fx:id="cartButton" text="🛒 Panier" onAction="#onCartClicked" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                     <Button fx:id="checkoutButton" text="💳 Commander" onAction="#onCheckoutClicked" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                  </children>
               </HBox>
            </children>
         </HBox>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #ecf0f1;">
         <GridPane fx:id="productsGrid" hgap="20.0" vgap="20.0" style="-fx-background-color: #ecf0f1;">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
         </GridPane>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #34495e;">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0"/>
         </padding>
         <children>
            <Label text="© 2024 E-Commerce Store - Développé avec JavaFX" textFill="white">
               <font>
                  <Font name="Arial" size="12.0"/>
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalLabel" text="Total: 0.00€" textFill="white">
               <font>
                  <Font name="Arial Bold" size="14.0"/>
               </font>
            </Label>
         </children>
      </HBox>
   </bottom>
</BorderPane>
