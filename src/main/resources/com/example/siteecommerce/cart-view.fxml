<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.siteecommerce.CartController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50;">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
         </padding>
         <children>
            <Button fx:id="backButton" text="← Retour" onAction="#onBackClicked" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Label text="🛒 MON PANIER" textFill="white">
               <font>
                  <Font name="Arial Bold" size="24.0"/>
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="cartTotalLabel" text="Total: 0.00€" textFill="white">
               <font>
                  <Font name="Arial Bold" size="18.0"/>
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #ecf0f1;">
         <VBox fx:id="cartItemsContainer" spacing="10.0" style="-fx-background-color: #ecf0f1;">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
         </VBox>
      </ScrollPane>
   </center>
   
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #34495e;">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0"/>
         </padding>
         <children>
            <Button fx:id="clearCartButton" text="🗑️ Vider le panier" onAction="#onClearCartClicked" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total final:" textFill="white">
               <font>
                  <Font name="Arial Bold" size="16.0"/>
               </font>
            </Label>
            <Label fx:id="finalTotalLabel" text="0.00€" textFill="white">
               <font>
                  <Font name="Arial Bold" size="20.0"/>
               </font>
            </Label>
            <Button fx:id="checkoutButton" text="💳 PASSER COMMANDE" onAction="#onCheckoutClicked" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px;"/>
         </children>
      </HBox>
   </bottom>
</BorderPane>
